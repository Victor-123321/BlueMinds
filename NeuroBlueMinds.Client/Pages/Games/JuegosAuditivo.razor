@page "/juegos/auditivo"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@inject ClientLocalizationService Loc
@inject IDashboardService DashboardSvc
@implements IDisposable

<PageTitle>@Loc.T("games.auditivo.title") - BlueMinds</PageTitle>

@if (_selectedGame == null)
{
    <GameSelector Category="auditivo"
        Title="@Loc.T("games.auditivo.title")"
        Subtitle="@Loc.T("games.auditivo.subtitle")"
        Icon="hearing"
        Games="_games"
        OnGameSelected="HandleGameSelected"
        Recommendations="_recommendations"
        SessionMessage="_sessionMessage"
        IsLoading="_loading" />
}
else
{
    <div class="p-4 bg-slate-50 min-h-screen">
        <button @onclick="() => _selectedGame = null"
                class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg shadow-md transition-all mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined">arrow_back</span> @Loc.T("games.back")
        </button>
        <GameContainer GameUrl="@_selectedGame.Url" Style="auditivo" />
    </div>
}

@code {
    private SelectedGame? _selectedGame;
    private bool _loading = true;
    private List<NeuroBlueMinds.Shared.DTOs.ActivityRecommendationDto>? _recommendations;
    private string _sessionMessage = "";

    protected override void OnInitialized() => Loc.OnLocaleChanged += StateHasChanged;
    public void Dispose()                   => Loc.OnLocaleChanged -= StateHasChanged;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var svc = (ClientDashboardService)DashboardSvc;
            var result = await svc.GetRecommendationsAsync();
            _recommendations = result.Recommendations
                .Where(r => r.Style == "auditivo")
                .ToList();
            _sessionMessage = result.SessionMessage ?? "";
        }
        catch
        {
            _recommendations = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleGameSelected(GameSelector.GameItem game) =>
        _selectedGame = new($"/games-static/auditivo/{game.Path}/index.html");

    private record SelectedGame(string Url);

    private static readonly List<GameSelector.GameItem> _games = new()
    {
        new("cadena-1",   "Cadena de Palabras",   "Crea cadenas de palabras sonoras.",       "link",       "nivel-1/Cadena-Palabras",           "1"),
        new("eco-1",      "Eco de Palabras",       "Repite las palabras que escuchas.",       "volume_up",  "nivel-1/eco-palabras",              "1"),
        new("cadena-2",   "Cadena de Palabras 2",  "Nivel avanzado de cadenas.",              "link",       "nivel-2/Cadena-Palabras2",          "2"),
        new("completa-2", "Completa la Oración",   "Escucha y completa la frase.",            "headphones", "nivel-2/Completa-Oracion-Auditiva", "2"),
        new("eco-3",      "Eco de Palabras 2",     "Repetición de frases complejas.",         "mic",        "nivel-3/eco-palabras-2",            "3"),
    };
}
