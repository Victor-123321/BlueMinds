    // ── Clinical Notes & Therapy Sessions ────────────────────────────────────────
    private async Task SelectPatient(PatientRow patient)
    {
        _selectedPatient = patient;
        _showNewSessionForm = false;
        _expandedSessionIds.Clear();
        _sessionSuccessMessage = false;
        ResetNewSessionForm();
        await LoadTherapySessions();
    }

    private async Task LoadTherapySessions()
    {
        if (_selectedPatient == null) return;

        _loadingSessions = true;
        try
        {
            var response = await Http.GetFromJsonAsync<List<TherapySessionDto>>(
                $"api/therapy/sessions/{_selectedPatient.ChildProfileId}");
            _therapySessions = response ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load therapy sessions");
        }
        finally
        {
            _loadingSessions = false;
        }
    }

    private void ToggleSessionExpanded(int sessionId)
    {
        if (_expandedSessionIds.Contains(sessionId))
            _expandedSessionIds.Remove(sessionId);
        else
            _expandedSessionIds.Add(sessionId);
    }

    private async Task SaveNewSession()
    {
        if (_selectedPatient == null) return;

        _savingSession = true;
        _sessionSuccessMessage = false;
        try
        {
            if (!DateTime.TryParse(_newSessionDate, out var sessionDate))
            {
                Logger.LogWarning("Invalid session date format");
                return;
            }

            var dto = new CreateTherapySessionDto
            {
                ChildProfileId = _selectedPatient.ChildProfileId,
                SessionDate = sessionDate,
                DurationMinutes = _newSessionDuration,
                Objectives = _newSessionObjectives,
                Notes = _newSessionNotes,
                Outcomes = _newSessionOutcomes
            };

            var response = await Http.PostAsJsonAsync("api/therapy/sessions", dto);
            if (response.IsSuccessStatusCode)
            {
                _sessionSuccessMessage = true;
                ResetNewSessionForm();
                _showNewSessionForm = false;
                await LoadTherapySessions();

                // Auto-hide success message after 3 seconds
                await Task.Delay(3000);
                _sessionSuccessMessage = false;
            }
            else
            {
                Logger.LogError($"Failed to save session: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving therapy session");
        }
        finally
        {
            _savingSession = false;
        }
    }

    private async Task DeleteSession(int sessionId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Estás seguro de que deseas eliminar esta sesión?"))
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/therapy/sessions/{sessionId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadTherapySessions();
            }
            else
            {
                Logger.LogError($"Failed to delete session: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting therapy session");
        }
    }

    private void CancelNewSession()
    {
        ResetNewSessionForm();
        _showNewSessionForm = false;
        _sessionSuccessMessage = false;
    }

    private void ResetNewSessionForm()
    {
        _newSessionDate = DateTime.Today.ToString("yyyy-MM-dd");
        _newSessionDuration = 60;
        _newSessionObjectives = "";
        _newSessionNotes = "";
        _newSessionOutcomes = "";
    }

    // ── Alert System & Filtering ───────────────────────────────────────────────────
    private List<PatientRow> GetFilteredPatients()
    {
        if (!_showOnlyAlerts) return patients;
        return patients.Where(p => GetPatientAlerts(p).Count > 0).ToList();
    }

    private List<AlertBadge> GetPatientAlerts(PatientRow patient)
    {
        var alerts = new List<AlertBadge>();

        // Calculate alerts based on game results history
        // For now, we check: no activity 7+ days, regresion detected

        // 1. Check if no activity in last 7 days (this would require GameResults data loaded)
        // Placeholder: would need to load game results per patient
        // For demo, we'll check the LastSession text
        if (patient.LastSession.Contains("más de"))
        {
            alerts.Add(new AlertBadge
            {
                Emoji = "🔴",
                Text = "Sin actividad 7+ días",
                BgClass = "bg-red-100 text-red-700"
            });
        }

        // 2. Check for regression (trend == "declining")
        if (patient.Trend == "declining")
        {
            alerts.Add(new AlertBadge
            {
                Emoji = "🟡",
                Text = "Regresión detectada",
                BgClass = "bg-yellow-100 text-yellow-700"
            });
        }

        // 3. No data yet
        if (patient.Progress == 0 && patient.LastSession == "-")
        {
            alerts.Add(new AlertBadge
            {
                Emoji = "⚪",
                Text = "Sin datos",
                BgClass = "bg-slate-100 text-slate-700"
            });
        }

        return alerts;
    }

    private class AlertBadge
