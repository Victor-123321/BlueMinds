    // ── Enhanced initialization to load therapy sessions when patient selected ──
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            specialistName = auth.User.FindFirst(ClaimTypes.Name)?.Value ?? "Especialista";

            // Run all calls in parallel for speed
            var patientsTask = Http.GetFromJsonAsync<List<PatientRow>>("api/access/my-patients");
            var statsTask    = Http.GetFromJsonAsync<SpecialistStatsResponse>("api/access/specialist-stats");
            var analysisTask = LoadAnalysisDataAsync();

            await Task.WhenAll(patientsTask, statsTask, analysisTask);

            var patientList = patientsTask.Result ?? new();
            var stats       = statsTask.Result;

            // Merge per-patient enrichment
            if (stats?.PatientStats != null)
            {
                var statMap = stats.PatientStats.ToDictionary(s => s.ChildUserId);
                foreach (var p in patientList)
                {
                    if (statMap.TryGetValue(p.ChildUserId, out var s))
                    {
                        p.Progress    = s.Progress;
                        p.Trend       = s.Trend;
                        p.LastSession = s.LastSession;
                    }
                }
            }

            patients         = patientList;
            patientCount     = patientList.Count;
            sessionsThisWeek = stats?.SessionsThisWeek ?? 0;
            reportsGenerated = stats?.ReportsGenerated ?? 0;
            avgProgress      = patientList.Any() ? (int)patientList.Average(p => p.Progress) : 0;

            // Auto-select first patient if available
            if (patients.Any())
            {
                await SelectPatient(patients.First());
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load specialist dashboard data");
        }
        finally
        {
            _loadingPatients = false;
            _loadingStats    = false;
            _loadingAnalysis = false;
            StateHasChanged();
        }
    }

    public void Dispose() => Loc.OnLocaleChanged -= StateHasChanged;
