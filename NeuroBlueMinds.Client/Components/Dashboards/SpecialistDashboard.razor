    // ── Patient row model (merges my-patients + specialist-stats) ────────────────
    private class PatientRow
    {
        public int     AccessId       { get; set; }
        public int     ChildProfileId { get; set; }
        public int     ChildUserId    { get; set; }
        public string  Name           { get; set; } = "";
        public string  Avatar         { get; set; } = "🦕";
        public string? DominantStyle  { get; set; }
        public int     SuggestedLevel { get; set; }
        public string  ParentName     { get; set; } = "";
        public string  AccessLevel    { get; set; } = "";
        public int?    AgeYears       { get; set; }
        // enriched from specialist-stats
        public int     Progress       { get; set; } = 0;
        public string  Trend          { get; set; } = "stable";
        public string  LastSession    { get; set; } = "-";
        // aliases
        public int     Level => SuggestedLevel;
    }

    // ── Lifecycle ────────────────────────────────────────────────────────────────
    protected override void OnInitialized()
        => Loc.OnLocaleChanged += StateHasChanged;

    private async Task LoadAnalysisDataAsync()
    {
        try
        {
            // Try to load analysis for the first patient if available
            var patientList = await Http.GetFromJsonAsync<List<PatientRow>>("api/access/my-patients");
            if (patientList?.Any() == true)
            {
                var firstPatient = patientList.FirstOrDefault();
                if (firstPatient != null)
                {
                    _deepAnalysis = await Http.GetFromJsonAsync<DeepAnalysisResult>(
                        $"api/dashboard/analysis/{firstPatient.ChildUserId}/{Uri.EscapeDataString(firstPatient.Name)}");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load analysis data");
            _analysisError = true;
            _analysisErrorMsg = "No se pudo cargar el análisis. Por favor, intenta más tarde.";
        }
    }

    private async Task HandleExportReport()
    {
        _exportingReport = true;
        try
        {
            // Trigger browser print dialog for generating PDF
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to export report");
        }
        finally
        {
            _exportingReport = false;
        }
    }

