@* SkeletonLoader.razor
   Universal skeleton loader component for async content.
   Usage: <SkeletonLoader Lines="3" /> or <SkeletonLoader Type="card" />
   Respects reduced motion settings *@

<div class="animate-pulse space-y-3" style="animation: @(ReducedMotion ? "none" : "pulse 2s cubic-bezier(0.4,0,0.6,1) infinite"); @(ReducedMotion ? "opacity: 0.7;" : "")">
    @if (Type == "card")
    {
        <div class="h-32 bg-slate-200 rounded-2xl"></div>
        <div class="h-4 bg-slate-200 rounded w-3/4"></div>
        <div class="h-4 bg-slate-200 rounded w-1/2"></div>
    }
    else if (Type == "avatar")
    {
        <div class="flex gap-3">
            <div class="w-12 h-12 bg-slate-200 rounded-full shrink-0"></div>
            <div class="flex-1 space-y-2">
                <div class="h-4 bg-slate-200 rounded w-2/3"></div>
                <div class="h-3 bg-slate-200 rounded w-1/2"></div>
            </div>
        </div>
    }
    else if (Type == "table-row")
    {
        <div class="flex gap-3">
            <div class="h-4 bg-slate-200 rounded w-1/6"></div>
            <div class="h-4 bg-slate-200 rounded w-1/4"></div>
            <div class="h-4 bg-slate-200 rounded w-1/3"></div>
            <div class="h-4 bg-slate-200 rounded w-1/4"></div>
        </div>
    }
    else
    {
        @* Default: Lines mode *@
        @for (int i = 0; i < Lines; i++)
        {
            <div class="h-4 bg-slate-200 rounded @(i == Lines-1 ? "w-2/3" : "w-full")"></div>
        }
    }
</div>

@code {
    /// <summary>Number of skeleton lines to render (default: 3). Only used in "lines" type.</summary>
    [Parameter]
    public int Lines { get; set; } = 3;

    /// <summary>Type of skeleton: "lines", "card", "avatar", "table-row". Default: "lines".</summary>
    [Parameter]
    public string Type { get; set; } = "lines";

    /// <summary>If true, animations are disabled for accessibility. Default: false.</summary>
    [Parameter]
    public bool ReducedMotion { get; set; } = false;
}
